
extends templates/layouts/layout

block css
	link(rel="stylesheet" href="styles/pages/info-table.scss")
	link(rel="stylesheet" href="styles/pages/activity-card.scss")
	link(rel="stylesheet" href="styles/pages/priority-section.scss")

block main
	include templates/widgets/hero
	include templates/mixins/activity-card
	include templates/mixins/priority-section

	- 
		const heroData = {
			title: 'персональный план образа жизни',
			text:'Добавки — это только часть пути. Здесь вы найдёте конкретные рекомендации по питанию, движению, сну и отдыху — всё с понятными цифрами и объяснением, почему это важно именно для вас. Внедряйте постепенно, в своём темпе.',
			imgUrl:"../images/star-13.webp"
		}

	+hero(heroData)

	include templates/pages/13

	- const pageCount = "13"
	include templates/widgets/footer