section.additional-block.two-col

  .supplements-table
    //- Шапка таблицы
    .table-row.header.typo-th
      span Наименование анализа
      span Обоснование

    -
      const supplements = [
        { name: 'Повторный липидный профиль', result: 'Убедиться в устойчивом достижении ЛПНП <3.0 ммоль/л; решить вопрос о лекарственной терапии.' },
        { name: 'Ферритин', result: 'Цель 70–100 мкг/л для стабильного роста волос и нормализации MCV.' },
        { name: 'Гомоцистеин', result:'Отследить влияние белка и витаминов группы B на метаболизм серы, особенно при дефиците селена.' },
        { name: 'УЗИ вен нижних конечностей', result: 'Оценить динамику варикозных изменений \nпосле физических и компрессионных мер.' },
      ]

    each item in supplements
      .table-row.typo-tv
        span.name= item.name
        span.result= item.result

.pattern-image-wrapper
  img.pattern-img(src="../images/pattern.webp" alt='pattern')
  