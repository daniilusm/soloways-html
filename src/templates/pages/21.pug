div.cards-wrapper 
  div.block-header
      .title-group
        h2.typo-h2 Анкетные данные

section.profile-container
  +profile-header({
    avatarUrl: '../images/avatar.webp',
    fullName: 'Фамилия Имя',
    gender: 'Женщина',
    age: '39 лет',
    height: '165 см',
    weight: '54-55 кг',
    reason: 'разобраться в причинах длительного выпадения волос (алопеции)'
  })        

section.block-wrapper
  .database-card
    div.gray-label
      h2.gray-label__title.typo-as Анамнез настоящего заболевания
    div.text-grid
      p.typo-tl= 'Клиентка отмечает выраженную проблему с выпадением волос в течение примерно 10 лет; основная причина обращения связана именно с этим.'
      p.typo-tl= 'Дополнительные жалобы включают частые головные боли или головокружения, чувство постоянной жажды, повышенную потливость и раздражительность или перепады настроения.'
      p.typo-tl= 'Со слов клиентки, выпадение волос вызывает значительную озабоченность и побудило к обращению за разъяснением причин при нормальных результатах анализов.'

  .database-card
    div.gray-label
      h2.gray-label__title.typo-as Образ жизни и питание
    section.habits-container
      .habits-grid
        +habit-item(
          'Физическая активность', 
          7, 
          'yellow', 
          'Спорт 3–4 раза в неделю'
        )
        +habit-item(
          'Питание', 
          10, 
          'green', 
          'Мясо и рыба более двух раз в неделю, свежие овощи несколько раз в неделю, при этом сладости употребляются ежедневно'
        )
        +habit-item(
          'Жидкость', 
          3, 
          'red', 
          'Суточный объём потребляемой воды ниже 2 литров. Кофе пьёт более одной чашки в день. Употребление алкоголя — несколько раз в месяц.'
        )

  .database-card
    div.gray-label
      h2.gray-label__title.typo-as Сон и эмоциональное состояние
    section.habits-container
      .habits-grid
        +habit-item(
          'Качество сна', 
          7, 
          'yellow', 
          'периодически просыпается по ночам'
        )
        +habit-item(
          'Уровень энергии', 
          10, 
          'green', 
          'нормальный утром, но снижается после обеда.'
        )
        +habit-item(
          'Стресс', 
          7, 
          'yellow', 
          'способы справляться со стрессом — спорт, хобби, общение с близкими.'
        )
    
