div.risk-cards
      -
        const risks = [
          {
            title: 'Повышенный общий оксидативный стресс → риск некоторых опухолей и раннего старения кожи',
            compare: '≈1.7 × выше',
            blood: [
              'Полная делеция GSTM и вариант SOD2 A/A снижают нейтрализацию свободных радикалов.',
              'Дефицит селена 0.106 мкг/г в волосах (норма ≥0.2) — главный «ко-фактор» Gpx-ферментов.'
            ],
            lifestyle: ['Волосы: кальций, магний, барий, стронций, железо — все повышены → каталитический «металлический» стресс.'],
            genetics: ['Семейный анамнез онкологии усиливает значимость нарушения.', 'Итог: клеточная ДНК подвергается чуть большему повреждению каждый день.'],
          },
          {
            title: 'Железодефицитная анемия (скрытая и явная)',
            compare: '≈3 × выше',
            blood: [
              'COMT A/A (“медленный“ фермент) → медленное разрушение адреналина и дофамина, нервная система постоянно «перегружена» сигналами стресса.'
            ],
            lifestyle: ['• Жалобы на раздражительность, перепады настроения, прерывистый сон.','• Высокий кофеиновый «фон» (более одной чашки кофе) поддерживает уровень катехоламинов.'],
            genetics: ['Перманентная потеря волос — дополнительный эмоциональный триггер.', 'Без профилактики может перейти в хроническую тревогу и соматические симптомы.'],
          }
        ]

      each risk in risks
        section.risk__card
          .risk__header
            h2.typo-as= risk.title
          
          .risk__badge.typo-th
            span Сравнение с популяцией
            span.badge-value= risk.compare
          
          .risk-details
            .detail-col
              h3.typo-th Кровь
              div.typo-tl
                each line in risk.blood
                  p= line
            
            .detail-col
              h3.typo-th Образ жизни
              div.typo-tl
                each line in risk.lifestyle
                  p= line
            
            .detail-col
              h3.typo-th Генетика
              div.typo-tl
                each line in risk.genetics
                  p= line

.pattern-image-wrapper
  img.pattern-img(src="../images/pattern.webp" alt='pattern')
  