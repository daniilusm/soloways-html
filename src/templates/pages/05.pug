section.additional-block.two-col
  div.block-header
    .title-group
      h2.typo-h2 Рекомендованное количество добавок Soloways
    .filter-tags
      span.tag.typo-td на курс 6 месяцев

  .supplements-table
    //- Шапка таблицы
    .table-row.header.typo-th
      span Название препарата
      span Количество банок

    -
      const supplements = [
        { name: 'Extra Glutation', dose: '2' },
        { name: 'Selenium', dose: '2' },
        { name: 'Iron Chelate', dose:'1' },
        { name: 'Vitamin C', dose: '2' },
        { name: 'Extra Omega-3', dose:'6' },
        { name: 'Extra Berberin', dose: '2' },
        { name: 'B-complex Extra', dose: '2' },
        { name: 'Biotin', dose: '2' },
        { name: 'PreBio Complex', dose: '2' },
        { name: 'Synbiotic', dose: '3' },
      ]

    each item in supplements
      .table-row.typo-tv
        a.name(href="#")= item.name
        span.dose= item.dose

.pattern-image-wrapper
  img.pattern-img(src="../images/pattern.webp" alt='pattern')
  