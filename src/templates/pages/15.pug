div.cards-wrapper  
  div.block-header
    .title-group
      h2.typo-h2 Сон и ментальное здоровье
    .filter-tags
      span.tag.typo-td 3 месяца

section.wellness-section
  +health-card([
    {
      title: 'Жалобы на ночные пробуждения',
      content: 'COMT A/A генетически усиливает реакцию на стресс — медитация снижает субъективный стресс на 20–30 %.'
    },
    {
      title: 'Нормализация сна',
      content: 'Нормализация сна связана со снижением вечернего кортизола → меньше выпадения волос.'
    }
  ])

section.dashboard__activities
  .activities-grid
    +activity-card('1', 'Дыхательная или направленная медитация', '10 мин утром и 10 мин перед сном (приложение-таймер или тихая музыка)')
    +activity-card('2', '«Цифровой закат»', 'за 60 мин до сна без ярких экранов; вместо них тёплый душ, книга, мягкий свет')
    +activity-card('3', 'Дневник самочувствия', '3 строки утром (сон, настроение, энергичность) и вечером (стресс-факторы, спасибо-лист)')
    +activity-card('4', 'Тренировки и ужин', 'Перенести интенсивные тренировки на время до 19:00, ужин за 2-3 ч до сна')

+priority-section('Почему это важно сейчас')
      .priority-grid
        +priority-column('Обоснование sufficiency')
          p Регулярная практика не требует оборудования и уже через 4–6 недель улучшает латентность сна и уменьшает эпизоды ночного пробуждения
          p Этого достаточно, чтобы решить, нужна ли дополнительная терапия

        +priority-column('Ожидаемый эффект')
          p Сон без пробуждений ≥5 ночей в неделю
          p Снижение дневной раздражительности на 2 балла по самооценке
          
img.pattern-img(src="../images/pattern.webp" alt='pattern')
