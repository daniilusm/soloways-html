div.cards-wrapper  
  div.block-header
    .title-group
      h2.typo-h2 Режим дня и прочие привычки
    .filter-tags
      span.tag.typo-td 3 месяца

section.wellness-section
  +health-card([
    {
      title: 'Польза компрессии',
      content: 'Компрессия снижает риск тромбофлебита на 50 % при раннем варикозе (рекомендации ACCP).'
    },
    {
      title: 'Регулярное питьё',
      content: 'Регулярное питьё уменьшит чувство жажды и головокружения, связанные с лёгкой дегидратацией.'
    }
  ])
      
section.dashboard__activities
  .activities-grid
    +activity-card('1', 'Компрессионные гольфы', '1 класса при длительной ходьбе/стоянии')
    +activity-card('2', 'Прием воды', 'Раз в 2 часа — 200 мл воды; поставить напоминание в телефоне')
    +activity-card('3', 'Солнечный свет', '15 мин дневного солнечного света для поддержания витамина D, так как уровень 52 нг/мл хорош, но зубной бракет может ограничивать жевательную активность и пребывание на улице')
    +activity-card('4', 'Комфортная обувь', 'Отказ от обуви с каблуком выше 4 см в будни')

+priority-section('Почему это важно сейчас')
      .priority-grid
        +priority-column('Обоснование sufficiency')
          p Эти меры не требуют лекарств, их эффект (объём вен, частота жажды) заметен в первые недели
          p К повторному визиту будет понятно, нужны ли дополнительные вмешательства

        +priority-column('Ожидаемый эффект')
          p Меньше отёчности лодыжек к вечеру
          p Уменьшение эпизодов жажды и головокружений
