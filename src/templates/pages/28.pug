div.cards-wrapper 
  div.block-header
    .title-group
      h2.typo-h2 Гормоны и гомоцистеин
    .filter-tags
      span.tag.typo-td 01 ноя 2025
        
section.analysis-section
  .analysis-table
    div.analysis-table__header.typo-th
      .analysis-table__head-cell Название
      .analysis-table__head-cell Количество
      .analysis-table__head-cell Норма
      .analysis-table__head-cell Состояние

    div.analysis-table__body
        +analysis-row('ФСГ', '', '14.55', 'мМЕд/мл', 'фолликул. фаза 3.03–8.08;\n середина цикла 2.55–16.69;\n лютеин. фаза 1.38–5.47', 'норма')
        +analysis-row('ЛГ', '', '4.76', 'мМЕд/мл', 'фолликул. фаза 1.80–11.78;\nсередина цикла 7.59–89.08;\nлютеин. фаза 0.56–14.00', 'норма')
        +analysis-row('Гомоцистеин', '', '6.34', 'мкмоль/л', 'норма: 4.44–13.56', 'норма')

div.cards-wrapper 
  div.block-header
    .title-group
      h2.typo-h2 Общий анализ крови (ОАК)
    .filter-tags
      span.tag.typo-td 27 окт 2025
        
section.analysis-section
  .analysis-table
    div.analysis-table__header.typo-th
      .analysis-table__head-cell Название
      .analysis-table__head-cell Количество
      .analysis-table__head-cell Норма
      .analysis-table__head-cell Состояние

    div.analysis-table__body
        +analysis-row('Тиреотропный гормон ', '(ТТГ)', '1.3284', 'мкМЕ/мл', '0.3500–4.9400', 'норма')
        +analysis-row('Трийодтиронин свободный', '(Т3 свободный)', '4.48', 'пмоль/л', '2.43–6.01', 'норма')
        +analysis-row('Тироксин свободный', '(Т4 свободный)', '12.82', 'пмоль/л', '9.00–19.05', 'норма')