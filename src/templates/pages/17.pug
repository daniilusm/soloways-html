div.cards-wrapper  
  div.block-header
    .title-group
      h2.typo-h2 Влияние на продолжительность жизни
    .filter-tags
      span.tag.typo-td 3 месяца

div.section-label.violet-bg.typo-th
  p= 'По крупным когортным исследованиям:'
      
section.dashboard__activities
  .activities-grid
    +activity-card('1', 'Снижение риска инфаркта', 'Снижение ЛПНП на 0.5 ммоль/л у женщин 35–55 лет уменьшает 10-летний риск инфаркта на 20%, что эквивалентно прибавке 1.8–2.4 года жизни.')
    +activity-card('2', 'Качество жизни', 'Повышение ферритина до 50–70 мкг/л у женщин репродуктивного возраста снижает общую смертность на 3–4% (≈0.2 года), но главное — качество жизни.')
    +activity-card('3', 'Регулярная медитация', 'Регулярная медитация (10 мин 5 раз/нед.) ассоциирована с уменьшением смертности от ССЗ на 10% (прибавка около 1 года).')
    +activity-card('4', 'Сокращение риска тромбов', 'Устранение вечернего застоя в венах сокращает риск тромботических событий на 30 %; прямой эквивалент ≈0.3 года.')

div.section-label.green-bg.typo-th
  p
    svg.effect-banner__svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round")
          polyline(points="20 6 9 17 4 12")
    span= 'Ожидаемый эффект'

p.block-wrapper.description-tex.typo-tv= 'Итого возможный суммарный выигрыш при сохранении привычек ≥5 лет – \nоколо 3–4 дополнительных лет здоровой жизни.'