div.cards-wrapper  
  div.block-header
    .title-group
      h2.typo-h2 Спорт и движение
    .filter-tags
      span.tag.typo-td 3 месяца


section.dashboard__activities
  .activities-grid
    +activity-card('1', 'Кардио / Силовая', 'Минимум 150 мин в неделю (плавание, эллипс, быстрая ходьба). 2 короткие по 20 мин с собственным весом')
    +activity-card('2', 'Венозная пауза', 'Каждые 60–90 мин сидячей работы — 5-минутная пауза: перекаты с пятки на носок, круги стопами, 10 приседаний')
    +activity-card('3', 'В рабочие дни', '5000–7000 шагов сверх обычной нагрузки; в обуви каблук не выше 4 см')
    +activity-card('4', 'Вечером', '3–5 мин лёжа с ногами выше уровня сердца')

+priority-section('Почему это важно сейчас')
      .priority-grid
        +priority-column('Обоснование sufficiency')
          p 12 недель — это физиологически обоснованный минимальный срок
          p Проявится положительная динамика по ключевым целевым показателям (липидам и ферритину) под влиянием диеты

        +priority-column('Ожидаемый эффект')
          p Снижение ЛПНП на 0.3–0.5 ммоль/л, повышение уровня ферритина
          p Уменьшение выпадения волос, снижение частоты головной боли и эпизодов раздражительности  