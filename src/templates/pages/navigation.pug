            { text: 'Персональная схема нутритивной поддержки', num: '09' },
            { text: 'Персональный трёхмесячный план образа жизни', num: '13' },
            { text: 'Приложения', num: '20' },
            { text: 'Контакты', num: '34' }
          ]
        
        each item in menuItems
          a.nav-item(href="#")
            span.nav-text= item.text
            span.nav-number= item.num