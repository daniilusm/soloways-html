div
      div.nav-page__info
        img(src="../images/bg-pattern.webp", alt="bg pattern")
        h1.typo-d-l навигация

      nav.nav-page__list
        - 
          const menuItems = [
            { text: 'Депрессия', num: '01' },
            { text: 'Тревожность', num: '04' },
            { text: 'СДВГ (дефицит внимания и гиперактивность)', num: '07' },
            { text: 'Когнитивные способности (память, концентрация)', num: '10' },
            { text: 'Склонность к зависимостям', num: '13' },
            { text: 'Стрессоустойчивость и выгорание', num: '16' },
            { text: 'Общий вывод и рекомендации', num: '19' },
            { text: 'Контакты', num: '23' },
          ]
        
        each item in menuItems
          a.nav-item(href=`/${item.num}.html`)
            span.typo-as= item.text
            span.typo-at= item.num