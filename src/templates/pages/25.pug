section.dynamics-container
  .dynamics-table
    div.dynamics-table__header.typo-th
      .dynamics-table__head-cell Показатель
      .dynamics-table__head-cell До
      .dynamics-table__head-cell После
      .dynamics-table__head-cell Состояние

    .dynamics-table__section
        div.gray-label
          h2.gray-label__title.typo-as= 'Витаминный статус'
        .dynamics-table__body
          +dynamic-row('Витамин B12', '5.12 ммоль/л', '11.12.2025', '4.82 ммоль/л', '15.12.2025', 'Устойчивый рост и стабилизация в пределах нормы (пик 684.19 pg/mL 09.04.2025)')
          +dynamic-row('Фолиевая кислота', '5.21 %', '04.03.2024', '5.27 %', '11.12.2025', 'Превышение нормы в 2022 г., затем возврат и стабильность в референсных значениях')
          +dynamic-row('Витамин D', '15.75 uIU/mL', '11.12.2025', '17.81 uIU/mL', '15.12.2025', 'Снижение от достаточного уровня до дефицитного (26.56 ng/mL 09.04.2025)')

.pattern-image-wrapper
  img.pattern-img(src="../images/pattern.webp" alt='pattern')
  