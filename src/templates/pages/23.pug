div.cards-wrapper

  +info-card('Семейный анамнез')
    +info-row('Наблюдения и жалобы', 'Со стороны близких родственников отмечаются сердечно-сосудистые заболевания (инфаркт, инсульт) и онкологические заболевания.')
    +info-row('Заболевания и диагноз', 'У отца был варикоз.')
    +info-row('Лечение и операции', 'Одна нога отца прооперирована.')

  +info-card('Репродуктивная и гинекологическая информация')
    +info-row('Наблюдения и жалобы', 'Клиентка имеет детей. Менструальный цикл регулярный. Во время менструаций отмечаются обильные кровотечения, болевые ощущения в первые дни цикла и проявления предменструального синдрома.')
    +info-row('Заболевания и диагноз', 'Диагностирована миома матки.')
    +info-row('Лечение и операции', 'Удалён полип тела матки в ноябре прошлого года.')

  +info-card('Сопутствующие состояния и другие сведения')
    +info-row('Наблюдения и жалобы', 'За последние четыре года весной отмечается поллиноз в период цветения берёзы. Клиентка носит брекеты в течение трёх месяцев.')
    +info-row('Заболевания и диагноз', 'Офтальмологически — миопия и астигматизм.')
    +info-row('Лечение и операции', 'Под текущие медикаменты и дополнительные обследования клиентка не поставлена.')

.pattern-image-wrapper
  img.pattern-img(src="../images/pattern.webp" alt='pattern')
  