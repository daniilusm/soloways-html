section.database-container
  .database-card
    div.gray-label
      h2.gray-label__title.typo-as Базы данных
    
    .database-card__content.database-list
      +database-row('888 000 ассоциаций по 7 273 исследованиям (релиз: май 2025)', 'GWAS Catalog')
      +database-row('220 000 метаболитов, справочные уровни и биохимические пути (KEGG)', 'HMDB v5.0')
      +database-row('49 000 липидов, классификация и маркёры воспаления', 'LipidMAPS')
      +database-row('Допустимые верхние уровни (29 нутриентов, версия 2023)', 'EFSA UL')
      +database-row('Доказательная база RCT и метаанализов', 'PubMed / Cochrane / Epistemonikos')

