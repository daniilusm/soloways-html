div.risk-cards
      -
        const risks = [
          {
            title: 'Атеросклероз и связанные сердечно-сосудистые события (инфаркт, инсульт)',
            compare: '≈2.5 × выше',
            blood: [
              'Общий холестерин 5.4 ммоль/л и ЛПНП 3.51 ммоль/л — выше референса (≤5.2 и ≤3.37 ммоль/л).',
              'Семейный анамнез инфаркта/инсульта.'
            ],
            lifestyle: ['Ежедневные сладости → инсулиновые «качели», дополнительное повреждение эндотелия.', 'Итог: формирование бляшек начнётся раньше, чем у «средней» женщины 38 лет.'],
            genetics: ['Генетика: дефектные ферменты GSTM (нет детоксикации) и SOD2 A/A (ослаблена защита сосудистой стенки от свободных радикалов).', 'Ген FADS1 G/G ухудшает синтез «полезных» омега-3.'],
          },
          {
            title: 'Железодефицитная анемия (скрытая и явная)',
            compare: '≈3 × выше',
            blood: [
              'Обильные менструации и миома — хроническая потеря крови.',
              'MCV 77 фл (ниже 80) и MCHC 376 г/л (относительное «сгущение») — типичная картина железодефицита.'
            ],
            lifestyle: ['Ферритин 34 мкг/л: в референсе, но для прекращения выпадения волос обычно требуется ≥70 мкг/л.'],
            genetics: ['Волосы выпадают 10 лет — непрямой маркер длительного латентного дефицита. Без коррекции запаса железа сгладится, а симптомы усилятся.'],
          }
        ]

      each risk in risks
        section.risk__card
          .risk__header
            h2.typo-as= risk.title
          
          .risk__badge.typo-th
            span Сравнение с популяцией
            span.badge-value= risk.compare
          
          .risk-details
            .detail-col
              h3.typo-th Кровь
              div.typo-tl
                each line in risk.blood
                  p= line
            
            .detail-col
              h3.typo-th Образ жизни
              div.typo-tl
                each line in risk.lifestyle
                  p= line
            
            .detail-col
              h3.typo-th Генетика
              div.typo-tl
                each line in risk.genetics
                  p= line