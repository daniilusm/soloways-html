div.cards-wrapper  
  div.block-header
    .title-group
      h2.typo-h2 Питание
    .filter-tags
      span.tag.typo-td 3 месяца

section.diet-recommendations
  .diet-recommendations__grid
    +food-card('../images/veggies.webp', 'Фрукты и овощи', '400 г разных цветов ежедневно')
    +food-card('../images/meat.webp', 'Постное мясо', 'Не чаще 1–2 раз/неделю')
    +food-card('../images/fish.webp', 'Рыба', '2–3 раза/неделю')
    +food-card('../images/sweets.webp', 'Сладкое', 'Уменьшить до 2 небольших порций/нед')
    +food-card('../images/grain.webp', 'Цельнозерновое', 'Вместо белой муки')
    +food-card('../images/trans-fats.webp', 'Транс-жиры и колбасы', 'Исключить')
    +food-card('../images/iron.webp', 'Железо и витамин С', 'Говяжья печень или чечевица + свежая петрушка/болгарский перец 2 раза/нед')
    +food-card('../images/selenium.webp', 'Селен из еды', '1–2 бразильских ореха в день, либо 120 г морской рыбы')
    +food-card('../images/water.webp', 'Суточная вода', '1.5–2 л; кофе не более 2 чашек и не во время железосодержащих блюд')

+priority-section('Почему это важно сейчас')
      .priority-grid
        +priority-column('Обоснование sufficiency')
          p Пищевые изменения влияют на липиды уже к 4-й неделе, а на запасы железа — к 8-й
          p Поэтому 12-недельный горизонт покажет, достаточно ли одной диеты или придётся обсуждать препараты

        +priority-column('Ожидаемый эффект')
          p ЛНПН снижение на 0.3–0.5 ммоль/л
          p Ферритин подъём до 50 мкг/л, уменьшение выпадения волос
          p Уменьшение головной боли и раздражительности за счёт селена и стабилизации сахара