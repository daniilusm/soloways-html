div.cards-wrapper

  +info-card('Биотин (витамин B7)')
    +info-row('Суточная дозировка', '2.5 мг (1 капс. с завтраком)')
    +info-row('Ключевая цель', 'Усиление роста и плотности волос, поддержка ногтевой пластины')
    +info-row('Обоснование необходимости приёма', '• При дозе 2.5 мг/сут через 90 дней у 67% женщин снижается дневная потеря волос по счетному тесту «60 sec». <br> • Необходимость обусловлена длинной историей алопеции и ношением брекетов (биотин участвует в минерализации).', '(3-месячный горизонт + критерии контроля)')

  +info-card('Пробиотик с пребиотиком (≥10^10 КОЕ)')
    +info-row('Суточная дозировка', '1 капс. перед сном')
    +info-row('Ключевая цель', 'Снижение вздутия живота и опосредованное улучшение всасывания железа')
    +info-row('Обоснование необходимости приёма', '• Дискинезия желчевыводящих путей и вздутие указывают на дисбиоз; нормализация микробиоты повышает биодоступность железа на 7–12%. <br> • Курс 12 недель достаточно, далее — по самочувствию.', '(3-месячный горизонт + критерии контроля)')

