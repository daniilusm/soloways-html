mixin hero(props)
  div.hero
    img.hero__star-img(src= props.imgUrl, alt="bg pattern")
    div.hero__bg
      img(src="../images/bg-pattern.webp", alt="bg pattern")

    .hero__brand-tag(class=props.classBrand)
      svg(width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg")
        path(d="M3.02627 1.10605C3.49014 -0.368684 5.50986 -0.368683 5.97373 1.10605C6.18118 1.76557 6.77614 2.2121 7.44746 2.2121C8.94857 2.2121 9.57269 4.19635 8.35827 5.10778C7.81517 5.51539 7.58791 6.23789 7.79536 6.89741C8.25923 8.37215 6.62524 9.59848 5.41082 8.68704C4.86771 8.27943 4.13229 8.27943 3.58918 8.68704C2.37477 9.59848 0.740774 8.37215 1.20464 6.89741C1.41209 6.23789 1.18483 5.51539 0.641726 5.10778C-0.572694 4.19635 0.0514352 2.2121 1.55254 2.2121C2.22386 2.2121 2.81882 1.76557 3.02627 1.10605Z" fill="#FAFAFD")
      p.typo-th= props.brandText
    
    .filter-tags.hero__tag(class=props.tagClass)
      span.tag.typo-td= props.tagText

    div.hero__text
      h1.typo-h1= props.title
      p.typo-st= props.text