doctype html
html(lang="en")
	head
		meta(charset="utf-8")
		meta(name="viewport" content="width=device-width,initial-scale=1")
		style.
			* {
				margin: 0; padding: 0;
			}

			body {
				background: #fafafa;
				font-size: 1.2rem;
				font-family: Arial, Helvetica, sans-serif;
				font-variant-numeric: tabular-nums;
			}

			a {
				padding: 1rem 1.2rem;
				display: block;
				color: #4846FE;
				text-decoration: none;
				border-bottom: 1px solid #f0f0f0;
				text-transform: capitalize;
			}

			a:visited {
				color: #333;
			}

			a:hover {
				background: #4846FE;
				color: #fff;
			}
	body
		ul
			li: a(href="01.html") 01. 01
			li: a(href="02.html") 02. 02
			li: a(href="03.html") 03. 03
			li: a(href="04.html") 04. 04
			li: a(href="05.html") 05. 05
			li: a(href="06.html") 06. 06
			li: a(href="07.html") 07. 07
			li: a(href="08.html") 08. 08
			li: a(href="09.html") 09. 09
			li: a(href="10.html") 10. 10
			li: a(href="11.html") 11. 11
			li: a(href="12.html") 12. 12
			li: a(href="main.html") 13. main
			li: a(href="navigation.html") 14. navigation
