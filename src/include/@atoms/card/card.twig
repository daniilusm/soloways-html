<a href="/catalog-detail.html" class="card {{ class ? class : "" }}">
	{% block content %}
		<div class="card__img">
            <img class="card__img-main" src="{{ img }}" alt="Превью чая" />
            <img class="card__img-hover" src="{{ hover }}" alt="Превью чая" />
        </div>
		<div class="card__info">
            <div class="card__title">{{ name }}</div>
            <div class="card__text">{{ desc }}</div>
        </div>
        <div class="card__icons">
            {% if bag %}
                {% view '@icon-symbol' with {name: 'bag'} %}
            {% endif %}
            {% if leaf %}
                {% view '@icon-symbol' with {name: 'leaf'} %}
            {% endif %}
            {% if pyramids %}
                {% view '@icon-symbol' with {name: 'pyramids'} %}
            {% endif %}
        </div>
	{% endblock %}
</a>