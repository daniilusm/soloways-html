{% slot '@taglink' with _context|merge({ pillow: 'button', class: 'btn ' ~ classMod }) %}
	{% block content %}
        <span class="btn__text">
            {{ text }}
        </span>
        {% if icon %}
            <div class="btn__icon">
                {% view '@icon-symbol' with { name: icon, class: 'btn__icon' } %}
            </div>
        {% endif %}
	{% endblock %}
{% endslot %}
