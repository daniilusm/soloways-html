{% if href %}
	{# Ссылка #}
	{{ '<a' }} href="{{ href }}"
	{% if external %}target="_blank"{% endif %}{% if class %} class="{{ class }}"{% endif %} {{ attr ?: '' }}>

{% elseif pillow == 'button' %}
	{# Если подушка - кнопка #}
	{{ '<button' }} type="{{ type ?: 'button' }}"{% if class %} class="{{ class }}"{% endif %} {{ attr ?: '' }} data-popup-type="{{ dataPopupType ?: '' }}">

{% elseif pillow %}
	{# Если присутствует подушка #}
	{% set tagStart = '<' ~ pillow %}
	{% set tagEnd = '</' ~ pillow ~ '>' %}
	{{ tagStart }} {% if class %} class="{{ class }}"{% endif %} {{ attr ?: '' }}>

{% else %}
	{# Тэг спан на крайний случай #}
	{{ '<span' }} {% if class %} class="{{ class }}"{% endif %} {{ attr ?: '' }}>
{% endif %}

{% block content %}{% endblock %}

{% if href %}
	{# Ссылка #}
	{{ '</a>' }}

{% elseif pillow == 'button' %}
	{{ '</button>' }}

{% elseif pillow %}
	{{ tagEnd }}

{% else %}
	{{ '</span>' }}
{% endif %}
