<!DOCTYPE html>
<html lang="{{ lang }}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
		<meta http-equiv="X-UA-Compatible" content="ie=edge">
		<title>{{ title }}</title>

		{# Icons #}
		{# Generated on https://realfavicongenerator.net/ #}
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#ee3124">
		<meta name="msapplication-TileColor" content="#ffffff">
		<meta name="theme-color" content="#ffffff">

		{# Убирает автоматическое обнаружение телефонов и превращение в тэг a:tel #}
		{# Случай в safari #}
		<meta name="format-detection" content="telephone=no">

		<link href="css/index.min.css?{{ date().getTime() }}" rel="stylesheet">
	</head>

	<body class="page">
        {% view "&header" with header %}

        <div class="page__wrapper">
            <main class="page__content">
                {% block content %}
                    Content
                {% endblock %}
            </main>
            <div class="page__footer" data-scroll-section>
                {% view "&footer" %}
            </div>
        </div>

		{# Scripts #}

		<script src="js/index.min.js?{{ date().getTime() }}" defer></script>
	</body>
</html>
